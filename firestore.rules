rules_version = '2';

// Firestore security rules for the Hazmat training log (project hazmat-training-d9ba8).
// Paste into Firebase console > Firestore Database > Rules, then Publish.
//
// - Anyone can ADD a training entry, but only in the exact shape the form sends.
// - Only the admin account(s) below can READ entries (the CSV download).
// - Nobody can edit or delete entries from the website.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['gpetrone80@gmail.com'];
    }

    function shortText(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    match /trainingLogs/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['trainingDate', 'firstName', 'lastName', 'department', 'submittedAt'])
                    && request.resource.data.trainingDate is string
                    && request.resource.data.trainingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && shortText(request.resource.data.firstName, 60)
                    && shortText(request.resource.data.lastName, 60)
                    && shortText(request.resource.data.department, 80)
                    && request.resource.data.submittedAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
